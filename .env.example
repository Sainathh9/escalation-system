# ============================================================
# IncidentFlow — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5001

# ── Database (PostgreSQL) ────────────────────────────────────
DB_USER=incidentflow
DB_PASSWORD=change_me_strong_password
DB_NAME=incidentflow_db
DB_HOST=localhost      # Docker: overridden to 'postgres' by docker-compose
DB_PORT=5432

# ── Authentication ───────────────────────────────────────────
# Use a long, random string. Generate with: openssl rand -hex 64
JWT_SECRET=change_me_super_secret_jwt_key_at_least_32_chars

# ── Redis (BullMQ Job Queue) ─────────────────────────────────
REDIS_HOST=127.0.0.1   # Docker: overridden to 'redis' by docker-compose
REDIS_PORT=6379

# ── Frontend URL (CORS Allowlist) ────────────────────────────
FRONTEND_URL=http://localhost:5173   # Docker: set to http://localhost

# ── Email Notifications (optional) ──────────────────────────
# Set EMAIL_ENABLED=true and fill in SMTP credentials.
# Emails are sent alongside real-time in-app notifications.
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="IncidentFlow <your_email@gmail.com>"
