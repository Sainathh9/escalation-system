# ============================================================
# IncidentFlow — Root .env for Docker Compose
# These variables are read by docker-compose.yml to configure
# all services. The backend service also loads this via env_file.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5001

# ── Database ─────────────────────────────────────────────────
DB_USER=incidentflow
DB_PASSWORD=incidentflow_pass
DB_NAME=incidentflow_db
DB_HOST=postgres
DB_PORT=5432

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=TopSecretKey

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Frontend URL ─────────────────────────────────────────────
FRONTEND_URL=http://localhost

# ── Email (optional) ─────────────────────────────────────────
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="IncidentFlow <noreply@incidentflow.local>"
